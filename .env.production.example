# Production env template for onestopstore.co.zw's laravel-api.
# Copy to .env on the server (or bake into the image build) and fill in every
# CHANGE_ME. Do NOT reuse raines.africa's live secrets — separate site, separate
# merchant/API accounts. DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT are forced by
# docker-compose.yml regardless of what's set here (see the environment: block
# on onestopstore-laravel-api) — left correct here just for consistency when
# running artisan commands via `docker compose exec`.

APP_NAME="OneStopStore"
APP_ENV=production
APP_KEY=                          # generate: docker compose exec onestopstore-laravel-api php artisan key:generate --show
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_TIMEZONE=Africa/Harare
APP_DOMAIN=onestopstore.co.zw
APP_EMAILS_DOMAIN="${APP_DOMAIN}"
SHOW_FAST_JSON_IMPORT_PAGE=false
LOG_MOBILE_DEBUG_ALL=false

PHOTOROOM_API_KEY=CHANGE_ME
PHOTOROOM_API_URL=https://sdk.photoroom.com/v1
PHOTOROOM_API_KEY_SANDBOX=CHANGE_ME

ZIMBABWE_TAX_RATE=15.5
ZAMBIA_TAX_RATE=16

TRUSTED_PROXIES=*
TRUSTED_HEADERS=X_FORWARDED_ALL

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=

SANCTUM_STATEFUL_DOMAINS=onestopstore.co.zw,www.onestopstore.co.zw,admin.onestopstore.co.zw,api.onestopstore.co.zw
CORS_ALLOWED_ORIGINS=https://onestopstore.co.zw,https://www.onestopstore.co.zw,https://admin.onestopstore.co.zw,https://media.onestopstore.co.zw

APP_URL=https://api.onestopstore.co.zw
ASSET_URL=https://api.onestopstore.co.zw
BACKEND_URL=https://admin.onestopstore.co.zw
FRONTEND_URL=https://onestopstore.co.zw
IMAGE_API_URL=https://media.onestopstore.co.zw/api

API_CACHE_REFRESH_BASE="${APP_DOMAIN}"

CRM_WEBHOOK_URL=https://crm.onestopstore.co.zw/api
CRM_BASE_URL=https://crm.onestopstore.co.zw
CRM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_64_CHARS      # must match laravel-crm's API_WEBHOOK_SECRET
CRM_WEBHOOK_ENABLED=true

IMAGES_CRON_ENABLED=false
IMAGES_CRON="*/5 * * * *"
RUN_COMMISSION_CRON=true
COMMISSION_CRON="*/10 * * * *"
HORIZON_SNAPSHOT_ENABLED=true

APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_THEME=blue

SLACK_WEBHOOK_URL=CHANGE_ME
SLACK_WEBHOOK_URL_APP_ALERTS=CHANGE_ME
SLACK_WEBHOOK_URL_SERVER_ALERTS=CHANGE_ME
SLACK_BOT_USER_OAUTH_TOKEN=CHANGE_ME
SLACK_BOT_USER_DEFAULT_CHANNEL=onestopstore-notifications

PERCENTAGE=1
TODAYS_RATE=13.5

USE_ELASTIC_SEARCH=true
SCOUT_DRIVER=elasticsearch
ELASTICSEARCH_HOST=http://onestopstore-elasticsearch:9200
ES_PRODUCTS_INDEX=products_search
ELASTICSEARCH_SSL_VERIFICATION=false
SCOUT_QUEUE=true
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME               # must match ELASTIC_PASSWORD passed to docker-compose.yml
DISABLE_AUTO_ELASTICSEARCH_INDEXING=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=onestopstore-postgresql
DB_PORT=5432
DB_DATABASE=onestopstore_api
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SCHEMA=public
ANALYTICS_DB_DATABASE=onestopstore_analytics   # separate DB (page_views, user_sessions, user_events, cart_abandonments); same host/user/password as above

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_DOMAIN=.onestopstore.co.zw
SESSION_COOKIE=onestopstore_api_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=api_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=onestopstore-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=admin@onestopstore.co.zw
MAIL_FROM_NAME="${APP_NAME}"
MAIL_NOREPLY_ADDRESS=no-reply@onestopstore.co.zw
MAIL_NOREPLY_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=

PAYPAL_MODE=live
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

PESEPAY_INTEGRATION_KEY=CHANGE_ME
PESEPAY_ENCRYPTION_KEY=CHANGE_ME
PESEPAY_RETURN_URL="${FRONTEND_URL}/en/account/order"
PESEPAY_RESULT_URL="${APP_URL}/pesepay/callback"

PAYFAST_MERCHANT_ID=CHANGE_ME
PAYFAST_MERCHANT_KEY=CHANGE_ME
PAYFAST_PASSPHRASE=CHANGE_ME
PAYFAST_SANDBOX=false
PAYFAST_RETURN_URL="${FRONTEND_URL}/en/account/order?status=successful"
PAYFAST_CANCEL_URL="${FRONTEND_URL}/en/account/order?status=cancelled"
PAYFAST_NOTIFY_URL="${APP_URL}/payfast/notify"
PESE_API_KEY=
PESE_SECRET_KEY=

DPO_BASE_URL=https://secure.3gdirectpay.com
DPO_COMPANY_TOKEN=CHANGE_ME
DPO_SERVICE_TYPE=CHANGE_ME
DPO_PTL=5
DPO_INIT_ENDPOINT=/API/v6/Transaction/CreatePayment
DPO_REDIRECT_TEMPLATE=/payv3.php?ID={token}
DPO_RETURN_URL="${FRONTEND_URL}/en/account/order?status=successful"
DPO_CANCEL_URL="${FRONTEND_URL}/en/account/order?status=cancelled"

YOCO_BASE_URL=https://payments.yoco.com/api
YOCO_PUBLIC_KEY=CHANGE_ME              # pk_live_...
YOCO_SECRET_KEY=CHANGE_ME              # sk_live_...
YOCO_WEBHOOK_SECRET=CHANGE_ME
YOCO_RETURN_URL="${FRONTEND_URL}/en/account/order?status=successful"
YOCO_CANCEL_URL="${FRONTEND_URL}/en/account/order?status=cancelled"
YOCO_LOG_INTENT=false
YOCO_ALLOW_POLL_FINALIZE=false

MSG91_AUTH_KEY=CHANGE_ME
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_WHATSAPP_SENDER_ID=CHANGE_ME
MSG91_WHATSAPP_ENABLED=false
MSG91_TEMPLATE_ORDER_NOTIFICATION=order_notification
MSG91_TEMPLATE_ACCOUNT_NOTIFICATION=account_notification

ANALYTICS_GEOIP_ENABLED=true
ANALYTICS_GEOIP_CACHE_TTL=604800
ANALYTICS_GEOIP_TIMEOUT=2
ANALYTICS_GEOIP_FALLBACK=true

GEOIP_IPAPI_ENABLED=true
GEOIP_IPAPI_ENDPOINT=https://ipapi.co
GEOIP_IPAPI_TOKEN=null
GEOIP_IPAPI_DAILY_LIMIT=1000

GEOIP_IPAPI_COM_ENABLED=true
GEOIP_IPAPI_COM_ENDPOINT=http://ip-api.com
GEOIP_IPAPI_COM_DAILY_LIMIT=64000

GEOIP_IPGEOLOCATION_ENABLED=false
GEOIP_IPGEOLOCATION_ENDPOINT=https://api.ipgeolocation.io
GEOIP_IPGEOLOCATION_TOKEN=null
GEOIP_IPGEOLOCATION_DAILY_LIMIT=1000

GEOIP_IPSTACK_ENABLED=false
GEOIP_IPSTACK_ENDPOINT=http://api.ipstack.com
GEOIP_IPSTACK_TOKEN=null
GEOIP_IPSTACK_DAILY_LIMIT=1000

# AI Analytics Provider — choose one: anthropic, groq, gemini, openrouter
AI_PROVIDER=CHANGE_ME
AI_SEARCH_ENABLED=true

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5
