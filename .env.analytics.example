# ============================================================================
# ANALYTICS DATABASE CONFIGURATION
# ============================================================================
#
# Analytics data is stored in a separate database to reduce write load on
# the main database. This includes:
#   - page_views (user page tracking)
#   - user_sessions (session management)
#   - user_events (click tracking, interactions)
#   - cart_abandonments (abandoned cart tracking)
#
# If not specified, analytics database will use the same credentials as
# the main database.
# ============================================================================

# Analytics Database Name (REQUIRED)
ANALYTICS_DB_DATABASE=raines_laravel_analytics_2026

# Analytics Database Host (optional, defaults to DB_HOST)
# ANALYTICS_DB_HOST=127.0.0.1

# Analytics Database Port (optional, defaults to DB_PORT)
# ANALYTICS_DB_PORT=3306

# Analytics Database Username (optional, defaults to DB_USERNAME)
# ANALYTICS_DB_USERNAME=root

# Analytics Database Password (optional, defaults to DB_PASSWORD)
# ANALYTICS_DB_PASSWORD=

# Analytics Database Connection URL (optional, alternative to above)
# ANALYTICS_DB_URL=mysql://user:password@host:port/database
